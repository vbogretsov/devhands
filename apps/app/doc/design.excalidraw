      "version": 537,
      "versionNonce": 687210905,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1745250709728,
      "link": null,
      "locked": false,
      "text": "1. Location must be not more than 1 minute old\n2. 100M couriers globally\n3. 100K managers globally\n4. Courier location accept latency < 200 (100)ms?",
      "fontSize": 22.221710307209822,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Location must be not more than 1 minute old\n2. 100M couriers globally\n3. 100K managers globally\n4. Courier location accept latency < 200 (100)ms?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vtuGLMa6vA2_ePVY0cIN2",
      "type": "rectangle",
      "x": 932.2006681371868,
      "y": 2218.6046554220584,
      "width": 708.4733728693122,
      "height": 207.74338198650207,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "f66jfBj_MhczSxIXEfdG_"
      ],
      "frameId": null,
      "index": "b4w",
