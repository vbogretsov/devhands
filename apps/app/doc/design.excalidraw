      "text": "Couriers Tracking System",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Couriers Tracking System",
      "autoResize": false,
