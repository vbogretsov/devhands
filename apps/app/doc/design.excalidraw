    {
      "id": "Ulg9KZzt415ScLdJdCqFd",
      "type": "text",
      "x": -4973.875414897849,
      "y": 736.6502936652971,
      "width": 1026.3115234375,
      "height": 231.66957611828377,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3Y",
      "roundness": null,
      "seed": 1536715703,
      "version": 830,
      "versionNonce": 824715543,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "_5UowbXovrgL83N8VcBuo",
          "type": "arrow"
        }
      ],
      "updated": 1745058829327,
      "link": null,
      "locked": false,
      "text": "1. Courier sends location every 5 seconds (12 times per minute)\n2. Average courrier work day: 4 hours\n3. Max regional courries amount: 1.5M (based on the research data)\n4. Each courier sends daily: 4 * 60 * 5 = 1200 location updates\n5. In a region couriers work during 8:00-24:00. 16 working hours\n6. Maxium in a region daily: (1500000 * 1200) = 1.8B locations updates\n7. Assumed uniform distribution because of the domain agnostic natutre of the application\n8. Max region RPS: 1.8B/(16*3600) = 32K req/sec of location updates",
      "fontSize": 23.166957611828376,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Courier sends location every 5 seconds (12 times per minute)\n2. Average courrier work day: 4 hours\n3. Max regional courries amount: 1.5M (based on the research data)\n4. Each courier sends daily: 4 * 60 * 5 = 1200 location updates\n5. In a region couriers work during 8:00-24:00. 16 working hours\n6. Maxium in a region daily: (1500000 * 1200) = 1.8B locations updates\n7. Assumed uniform distribution because of the domain agnostic natutre of the application\n8. Max region RPS: 1.8B/(16*3600) = 32K req/sec of location updates",
      "autoResize": true,
      "lineHeight": 1.25
    },
