    },
    {
      "id": "O_Ob8uniiOf2lzjdz3GiB",
      "type": "text",
      "x": -5829.823436205491,
      "y": 1266.4514494082043,
      "width": 1596.3766869055708,
      "height": 102.03125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UikXY1FYx99P0brVtgjJE"
      ],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 1549555135,
      "version": 634,
      "versionNonce": 448358815,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743952115218,
      "link": null,
      "locked": false,
      "text": "Multi-Tenant Global World domain agnostic couriers tracking system. It provides integration API for the third-party\nservices (tenants) that integrate courriers and their routes. The main system functionality: recive courier location,\nprovide realtime couriers locations, couriers history and analytics.",
      "fontSize": 27.208333333333336,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Multi-Tenant Global World domain agnostic couriers tracking system. It provides integration API for the third-party services (tenants) that integrate courriers and their routes. The main system functionality: recive courier location, provide realtime couriers locations, couriers history and analytics.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "HWc0HKDz6lfrni7Ruyht4",
      "type": "text",
      "x": -2485.7251515379558,
      "y": 1463.182530096299,
      "width": 655.3958129882812,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Mw-yd-m-GVGGlLAZ_aiuJ"
      ],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 921257439,
      "version": 616,
      "versionNonce": 388154321,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1743952115218,
      "link": null,
      "locked": false,
      "text": "Research data:\n- Couriers in Russia (Minproptorg): ~1.5M\n- Couriers in USA: ~4M\n- Couriers in EU: ~4M\n- Couriers in UK: ~0.8M\n- Couriers in China: 15M\n- Couriers in India: 10M\n- Couriers in Latin America: 9M\n(Assumption) Couriers in rest of the world: 30M\nTotal: ~75M\n- (Assumption) Growing Market: 100M",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Research data:\n- Couriers in Russia (Minproptorg): ~1.5M\n- Couriers in USA: ~4M\n- Couriers in EU: ~4M\n- Couriers in UK: ~0.8M\n- Couriers in China: 15M\n- Couriers in India: 10M\n- Couriers in Latin America: 9M\n(Assumption) Couriers in rest of the world: 30M\nTotal: ~75M\n- (Assumption) Growing Market: 100M",
      "autoResize": true,
      "lineHeight": 1.25
    },
