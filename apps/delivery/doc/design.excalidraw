      "type": "text",
      "x": -2487.8235438407974,
      "y": 2063.017313413526,
      "width": 541.034423828125,
      "height": 111.1085515360491,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
